from pop import Oled, delay
display = Oled()

n1 = int(input())
display.print(n1)
while True:
    c = input()
    display.print(c)
    if c=='q':
        break
    
    n2 = int(input())
    display.print(n2)
    
    if c=='+':
        n1 = n1 + n2
    elif c == '-':
        n1 = n1 - n2
    elif c == '*':
        n1 = n1 * n2
    elif c == '/':
        n1 = n1 / n2
    else:
        continue
        
    display.print("=")
    display.print(n1)
